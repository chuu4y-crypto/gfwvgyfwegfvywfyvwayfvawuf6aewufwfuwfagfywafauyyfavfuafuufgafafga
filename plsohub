-- Place this variable and loop ABOVE your MainTab:CreateSlider script block
local currentSpeed = 16
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

RunService.RenderStepped:Connect(function()
    local char = player.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = currentSpeed
        end
    end
end)

-- Your adjusted Rayfield Slider configuration:
local Slider = ExploitTab:CreateSlider({
   Name = "Walkspeed Slider",
   Range = {26, 300},
   Increment = 1,
   Suffix = " Speed",
   CurrentValue = 26, -- Set to 16 so it starts at default Roblox speed
   Flag = "Slider1", 
   Callback = function(Value)
       -- Updates the background loop variable instantly when you slide
       currentSpeed = Value
   end,
})

